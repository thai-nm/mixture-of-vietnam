{
  "$schema": "vscode://schemas/color-theme",
  "name": "Hai Duong Vellum Gilt Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#a07a40",
    "foreground": "#3d3a37",
