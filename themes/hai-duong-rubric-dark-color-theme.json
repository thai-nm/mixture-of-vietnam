    "textPreformat.foreground": "#facb8d",
    "widget.border": "#2d2b2b",
    "widget.shadow": "#00000022",
    "button.background": "#e1ad66",
    "button.foreground": "#1a1816",
    "button.hoverBackground": "#facb8d",
    "button.secondaryBackground": "#141311",
    "button.secondaryForeground": "#eae7e7",
    "button.secondaryHoverBackground": "#2d2b2b",
    "badge.background": "#e1ad66",
